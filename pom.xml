                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>${maven-compiler-plugin.version}</version>
                        <configuration>
                            <showDeprecation>true</showDeprecation>
                            <showWarnings>true</showWarnings>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>
                                    -Xplugin:ErrorProne
                                    -XepExcludedPaths:.*/target/(generated-sources|generated-test-sources)/.*
                                    -XepPatchChecks:ArgumentSelectionDefectChecker,ArrayAsKeyOfSetOrMap,ArrayEquals,AssertEqualsArgumentOrderChecker,AssertFalse,BadImport,BadInstanceof,BooleanParameter,BoxedPrimitiveConstructor,CanIgnoreReturnValueSuggester,ClassName,CollectionIncompatibleType,ComparisonContractViolated,ComparisonOutOfRange,DeadException,DefaultCharset,DepAnn,DoubleBraceInitialization,DuplicateMapKeys,EmptyBlockTag,EmptyCatch,EmptyIf,EqualsGetClass,EqualsHashCode,EqualsIncompatibleType,FieldCanBeFinal,FormatString,FutureReturnValueIgnored,IdentityBinaryExpression,IntLongMath,InvalidBlockTag,InvalidInlineTag,InvalidParam,InvalidThrows,IterablePathParameter,JavaDurationWithNanos,JavaDurationWithSeconds,JavaInstantGetSecondsGetNano,JavaLocalDateTimeGetNano,JavaLocalTimeGetNano,JavaTimeDefaultTimeZone,LockOnBoxedPrimitive,LongLiteralLowerCaseSuffix,LoopOverCharArray,MathAbsoluteRandom,MethodCanBeStatic,MissingFail,MissingOverride,ModifiedButNotUsed,ModifyCollectionInEnhancedForLoop,ModifySourceCollectionInStream,MultipleParallelOrSequentialCalls,MultipleTopLevelClasses,MutableConstantField,MutablePublicArray,NarrowingCompoundAssignment,NonCanonicalStaticMemberImport,NonCanonicalType,NullOptional,NullableConstructor,NullableOptional,NullablePrimitive,NullablePrimitiveArray,NullableTypeParameter,NullableVoid,NullableWildcard,NumericEquality,ObjectToString,OperatorPrecedence,OptionalEquality,PackageLocation,ParameterName,PreconditionsCheckNotNull,PreconditionsCheckNotNullPrimitive,PrimitiveAtomicReference,PrivateConstructorForUtilityClass,RandomModInteger,ReferenceEquality,RemoveUnusedImports,ReturnValueIgnored,SelfAssignment,SelfComparison,SelfEquals,ShortCircuitBoolean,StaticAssignmentInConstructor,StaticGuardedByInstance,StreamResourceLeak,StringSplitter,SynchronizeOnNonFinalField,SystemExitOutsideMain,ThreadJoinLoop,ThreadLocalUsage,TryFailThrowable,TypeParameterNaming,TypeParameterUnusedInFormals,UnnecessaryAssignment,UnnecessaryCheckNotNull,UnnecessaryLambda,UnnecessaryMethodReference,UnnecessaryParentheses,UnusedException,UnusedMethod,UnusedNestedClass,UnusedVariable,WaitNotInLoop,WildcardImport
                                    -XepPatchLocation:IN_PLACE
                                </arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${error-prone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>${nullaway.version}</version>
                                </path>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>

                </plugins>
            </build>

        </profile>
    </profiles>

